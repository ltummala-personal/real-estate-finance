{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "real-estate-finance",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-14",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "DjangoContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP",
        "class_name": "DjangoContainer"
      }
    ]
  },
  "exports": {
    "DjangoContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    // Comma-separated public host names, e.g. "finance.example.com". Empty = use the host of the first request.
    "APP_HOSTNAMES": "",
    // lite | basic | standard-1 | standard-2 ... (OCR needs at least standard-1)
    "CONTAINER_INSTANCE": "standard-1",
    "DJANGO_HSTS_SECONDS": "3600",
    "DOCUMENT_MAX_UPLOAD_MB": "10",
    "R2_BUCKET": "real-estate-finance-uploads",
    // Cloudflare account ID (dashboard > Workers & Pages > right sidebar); used for the R2 endpoint.
    "R2_ACCOUNT_ID": "",
    "DJANGO_SUPERUSER_USERNAME": "admin"
  }
}
